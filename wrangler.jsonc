{
  // A Worker with static assets only: no script, the built page is served from dist/.
  // It serves badil.dev as a Custom Domain; CI deploys it from main. www.badil.dev
  // redirects to it with a zone Redirect Rule, outside this file.
  "name": "badil-dev",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "badil.dev", "custom_domain": true }
  ]
}
