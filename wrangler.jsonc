{
  // A Worker with static assets only: no script, the built page is served from dist/.
  // It serves badil.dev and www.badil.dev as Custom Domains; CI deploys it from main.
  "name": "badil-dev",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "badil.dev", "custom_domain": true },
    { "pattern": "www.badil.dev", "custom_domain": true }
  ]
}
